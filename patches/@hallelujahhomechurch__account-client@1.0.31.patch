+/** Display hints only. Never use these IDs to authorize a route, request, or action. */
+export type NavigationSource = 'account' | 'operations' | 'resources';
+type Projection = {
+    ids: readonly string[];
+    verifiedAt: number;
+};
+export type NavigationPresentation = {
+    ready: boolean;
+    subjectId: string | null;
+    sources: Partial<Record<NavigationSource, Projection>>;
+};
+export declare const emptyNavigationPresentation: NavigationPresentation;
+export declare const navigationPresentationTTL: number;
+type StorageLike = Pick<Storage, 'getItem' | 'setItem' | 'removeItem'>;
+export declare function createNavigationPresentation({ key, allowedIds, storage, now }: {
+    key: string;
+    allowedIds: readonly string[];
+    storage?: StorageLike;
+    now?: () => number;
+}): {
+    getSnapshot: () => NavigationPresentation;
+    subscribe(listener: () => void): () => void;
+    onInvalidate(listener: () => void): () => void;
+    identify(subjectId: string): void;
+    /** Capture after verified identity, before starting the source's asynchronous request. */
+    capture(subjectId: string): (source: NavigationSource, ids: readonly string[]) => boolean;
+    clear(): void;
+};
+export type NavigationPresentationStore = ReturnType<typeof createNavigationPresentation>;
+export {};
